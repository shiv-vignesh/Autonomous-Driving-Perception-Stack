{
    "dataset_kwargs":{
        "_type":"kitti",
        "kitti_trainer_dataset_kwargs":{
            "lidar_dir":"data/KiTTi/training/velodyne",
            "calibration_dir":"data/KiTTi/training/calib",
            "left_image_dir":"data/KiTTi/training/image_2",
            "right_image_dir":null,
            "labels_dir":"data/KiTTi/training/label_2",
            "shuffle":false,
            "apply_augmentation":false, 
            "batch_size":8
        },
        "kitti_validation_dataset_kwargs":{
            "lidar_dir":"data/KiTTi/validation/velodyne",
            "calibration_dir":"data/KiTTi/validation/calib",
            "left_image_dir":"data/KiTTi/validation/image_2",
            "right_image_dir":null,
            "labels_dir":"data/KiTTi/validation/label_2",
            "shuffle":false,
            "apply_augmentation":false, 
            "batch_size":12          
        }, 
        "image_resize":[640, 640], 
        "perform_validation":false
    }, 
    "model_kwargs":{
        "model_type":"mlsf_yolov8",
        "mlsf_yolo_kwargs":{
            "cfg_file":"config/yolov3-yolo_reduced_classes.cfg",
            "yolov8_weights_path":"yolov8l.pt",
            "image_channels":3, 
            "lidar_channels":3, 
            "image_backbone_device":"cuda:16",
            "lidar_backbone_device":"cuda:17",
            "adaptive_fusion_device":"cuda:19",
            "model_seed":101,
            "apply_adaptive_fusion":true, 
            "fusion_type":"attention",
            "num_fusion_blocks":2, 
            "weighted_fusion":false
        },
        "mlsf_ssd_kwargs":{
            "cfg_file":"config/mobilenetv2.cfg",
            "image_channels":3, 
            "lidar_channels":3, 
            "image_resize":[375, 1242], 
            "feature_map_size":[60, 20], 
            "detection_depths":["InvertedResidual_6", "InvertedResidual_12", "InvertedResidual_15"],
            "image_backbone_device":"cuda:14",
            "lidar_backbone_device":"cuda:15",
            "adaptive_fusion_device":"cuda:16",
            "model_seed":101,
            "apply_adaptive_fusion":false,
            "use_lidar_backbone":false
        }
    },
    "optimizer_kwargs":{
        "_description": "default_lr is for any layer other than lm",
        "_type": "AdamW", 
        "image_backbone_lr":3e-3, 
        "lidar_backbone_lr":3e-3,
        "adaptive_fusion_lr":3e-3,
        "ssd_head_lr":5e-3,
        "momentum":0.9,
        "weight_decay":0.9, 
        "tune_lidar_backbone":true,
        "tune_image_backbone":true
    },
    "lr_scheduler_kwargs":{
        "_type":"cosine",
        "linear_lr_kwargs":{
            "start_factor":1.0,
            "end_factor":0.01
        },
        "cosine_annealing_lr_kwargs":{
            "eta_min":1e-5
        }

    },
    "trainer_kwargs":{
        "output_dir": "MLSF-YOLOv8-large-Attention",
        "is_training":true,
        "first_val_epoch": 0,
        "metric_eval_mode": "strict",
        "metric_average_mode": "macro",
        "epochs": 50,
        "monitor_train": true,
        "monitor_val": true,
        "gradient_clipping": 1.0,
        "checkpoint_idx":5,
        "gradient_accumulation_steps":4,
        "p_modality_dropout":0.3,
        "modality_dropout":false,
        "modality_corrupt":false,
        "robustness_augmentations":["SaltPapperNoise", "pixelate"]
    }
}

